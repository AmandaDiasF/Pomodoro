<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="?android:attr/colorBackground">

    <TextView
        android:id="@+id/tvTituloMotivacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Frase Motivacional"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textColor="@color/text_dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvFrase"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Clique no botão para carregar uma frase."
        android:textSize="20sp"
        android:textStyle="italic"
        android:gravity="center"
        android:textAlignment="center"
        android:textColor="@color/text_dark"
        app:layout_constraintTop_toBottomOf="@id/tvTituloMotivacao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvAutor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Autor"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textAlignment="center"
        android:textColor="@color/text_muted"
        app:layout_constraintTop_toBottomOf="@id/tvFrase"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBuscarFrase"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Buscar frase"
        android:textStyle="bold"
        app:backgroundTint="@color/coral_primary"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvAutor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>